# Local sample preview needs no environment file: npm run dev
# Hosted adapter requires a NEW PostgreSQL database, never the sample database.
# Supply secrets using your hosting provider's secret manager. Never commit values.
GV_PUBLIC_ORIGIN=https://workspace.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=configure-at-provider
OIDC_CLIENT_SECRET=configure-in-secret-manager
# Register exactly: https://workspace.example.com/auth/callback
# Provider must supply a verified email and support authorization-code + PKCE.
# Explicit migrations: GV_MIGRATION_TARGET=oidc npm run db:migrate
# Build/serve only after reviewed configuration and release checks.
GV_BIND_HOST=127.0.0.1
PORT=4320
